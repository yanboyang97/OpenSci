# Source only after service/entity/location and data eligibility have been confirmed.
# This file has no key. ADC is established separately in this SAME Linux/WSL account.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN
unset ANTHROPIC_BASE_URL ANTHROPIC_VERTEX_BASE_URL
unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_FOUNDRY
export CLAUDE_CONFIG_DIR="$HOME/.config/opensci/claude-vertex"
export CLAUDE_CODE_USE_VERTEX=1
export ANTHROPIC_VERTEX_PROJECT_ID="YOUR_GCP_PROJECT_ID"
export CLOUD_ML_REGION="global"
export ANTHROPIC_MODEL="claude-sonnet-5-5"
export ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-5-5"
export ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-5-5"
# Explicitly keep background/small-model calls on the model you enabled.
# This maps the small-model role to Sonnet; it does NOT turn Sonnet into Haiku.
export ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-sonnet-5-5"
export CLAUDE_CODE_DISABLE_MODEL_ACCESS_FALLBACK=1
export CLAUDE_CODE_DISABLE_1M_CONTEXT=1
export GOOGLE_CLOUD_PROJECT="$ANTHROPIC_VERTEX_PROJECT_ID"
export GOOGLE_CLOUD_LOCATION="$CLOUD_ML_REGION"
mkdir -p "$CLAUDE_CONFIG_DIR"
chmod 700 "$CLAUDE_CONFIG_DIR"
